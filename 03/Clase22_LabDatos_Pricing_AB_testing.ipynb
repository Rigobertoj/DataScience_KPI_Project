     "text": [
      "El tamaño mínimo de la muestra es: 36.0\n"
     ]
    }
   ],
   "source": [
    "z_alpha_2 = 1.96 \n",
    "z_beta = 0.84\n",
    "\n",
    "desviacion_estandar = 30  # 30 USD\n",
    "diferencia_minima = 20\n",
    "\n",
    "sample_size = (2*((z_alpha_2+z_beta)**2)*desviacion_estandar**2)\\\n",
    "                /(diferencia_minima)**2\n",
    "print(f'El tamaño mínimo de la muestra es: {np.ceil(sample_size)}')"
   ]
