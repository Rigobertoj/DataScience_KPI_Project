   "source": [
    "import numpy as np \n",
    "\n",
    "z_alpha_2 = 1.96 \n",
    "z_beta = 0.84\n",
    "\n",
    "conversion_base = 0.05\n",
    "conversion_target = 0.04\n",
    "\n",
    "sample_size = (2*((z_alpha_2+z_beta)**2)*conversion_base*(1-conversion_base))\\\n",
    "                /(conversion_target - conversion_base)**2\n",
    "print(f'El tamaño mínimo de la muestra es: {np.ceil(sample_size)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1247ef34-7411-421d-a60f-2dd831d8ef4c",
