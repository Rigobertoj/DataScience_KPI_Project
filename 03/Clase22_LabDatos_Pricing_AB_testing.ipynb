    "# Comparar conversiones\n",
    "import numpy as np\n",
    "import statsmodels.api as sm\n",
    "\n",
    "conversions_a = 48\n",
    "total_a = 1000\n",
    "conversions_b = 30\n",
    "total_b = 900\n",
    "\n",
    "# Calcular conversion rate\n",
    "rate_a = conversions_a / total_a\n",
    "rate_b = conversions_b / total_b\n",
    "\n",
    "# Hacer un z-test de proporciones\n",
    "count = np.array([conversions_a, conversions_b])\n",
    "nobs = np.array([total_a, total_b])\n",
    "z_stat, p_value = sm.stats.proportions_ztest(count, nobs, alternative='larger')\n",
    "\n",
    "print(f'Tasa de conversión grupo A: {rate_a*100:.4f}%')\n",
    "print(f'Tasa de conversión grupo B: {rate_b*100:.4f}%')\n",
    "print(f\"Z-statistic: {z_stat:.4f}, P-value: {p_value:.4f}\")"
   ]
