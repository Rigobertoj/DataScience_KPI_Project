    "# Mismo número de observaciones en ambas muestras\n",
    "import scipy.stats as stats\n",
    "\n",
    "# LTV del Grupo A y Grupo B\n",
    "ltv_grupo_a = [100, 110, 105, 98, 102, 95, 107]  # LTV con precio de 10 USD\n",
